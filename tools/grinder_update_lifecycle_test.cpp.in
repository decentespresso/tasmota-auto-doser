bool GrinderTcpRelayOwned();
struct {
  bool begin(uint32_t) { assert(output_power == 0); return true; }
  size_t write(uint8_t *, size_t size) {
    assert(output_power == 0);
    assert(!GrinderTcpRelayOwned());
    ++update_writes;
    return update_write_success ? size : 0;
  }
  bool end(bool = false) { assert(output_power == 0); return update_end_success; }
} Update;
