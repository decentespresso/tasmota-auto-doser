__DRIVER_STATE__

struct {
  uint32_t power = 0, last_power = 0, blink_mask = 0, rel_inverted = 0;
  uint32_t pulse_timer[1] = {0};
  uint32_t power_on_delay = 0, power_on_delay_state = 0;
  uint8_t restart_flag = 0, ota_state_flag = 0;
  bool stop_flash_rotate = false;
} TasmotaGlobal;

struct SettingsData {
  uint32_t power_lock = 0, power = 0;
  uint32_t pulse_timer[1] = {0}, param[1] = {0};
  struct { bool save_state = true, stop_flash_rotate = false; } flag;
} settings;
using TSettings = SettingsData;
SettingsData *Settings = &settings;

struct {
  uint32_t server_stops = 0, server_starts = 0, server_generation = 0;
  uint32_t active_remote_ip = 0, active_remote_port = 0;
  uint32_t active_disconnects = 0;
  char last_close_reason[24] = {};
} GrinderTcpDiag;

